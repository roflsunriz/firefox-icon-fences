{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "{{VERSION}}",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/roflsunriz/firefox-icon-fences",
  "default_locale": "en",
  "icons": {
    "48": "icons/fence.svg",
    "96": "icons/fence.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{{ID}}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_area": "navbar",
    "default_icon": "icons/fence.svg",
    "default_title": "__MSG_actionTitle__"
  }
}
